---
import '../styles/global.css';
import { site } from '../data/site';

const BASE = import.meta.env.BASE_URL;
const { title = `${site.name} — ${site.tagline}`, description = site.heroDesc } = Astro.props;
const ogImage = `${site.site ?? 'https://cmcc-tao.github.io'}${BASE}og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${BASE}favicon.svg`} />
    <script is:inline>
      // Respect saved theme; default to light (white).
      const t = localStorage.getItem('theme');
      const dark = t ? t === 'dark' : false;
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>
  <body class="bg-white text-slate-900 dark:bg-ink dark:text-slate-200">
    <main>
      <slot />
    </main>

    <script>
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
