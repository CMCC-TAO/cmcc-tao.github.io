---
import { projects } from '../data/site';
---

<section id="projects" class="section">
  <div class="container-wide">
    <div class="reveal mb-10 max-w-2xl">
      <span class="eyebrow">Projects</span>
      <h2 class="text-3xl font-bold sm:text-4xl">Our Open-Source Projects</h2>
      <p class="mt-3 text-slate-400">
        Building the full stack from embodied base models to real-world robot deployment.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p) => (
          <article class="card lift reveal flex flex-col">
            <div class="mb-4 flex items-center justify-between">
              <span class="eyebrow mb-0">{p.category}</span>
              <span class="text-2xl" aria-hidden="true">{p.icon}</span>
            </div>

            <h3 class="text-xl font-bold">{p.name}</h3>
            <p class="mt-1 text-sm font-semibold text-brand-light">{p.tagline}</p>
            <p class="mt-3 flex-1 text-sm text-slate-400">{p.desc}</p>

            {p.highlights && (
              <div class="mt-4 grid grid-cols-2 gap-3 border-t border-ink-border pt-4">
                {p.highlights.map((h) => (
                  <div>
                    <div class="stat text-2xl">{h.value}</div>
                    <div class="text-xs text-slate-500">{h.label}</div>
                  </div>
                ))}
              </div>
            )}

            <div class="mt-4 flex flex-wrap gap-2">
              {p.tags.map((tag) => (
                <span class="rounded-full border border-ink-border px-2.5 py-0.5 text-xs text-slate-400">
                  {tag}
                </span>
              ))}
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
              {p.links.map((l) => (
                <a
                  class="btn-ghost px-4 py-2 text-xs"
                  href={l.href}
                  target="_blank"
                  rel="noopener"
                >
                  {l.label} →
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
