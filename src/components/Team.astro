---
import { site, team } from '../data/site';
---

<section id="team" class="section">
  <div class="container-wide">
    <div class="reveal mb-10 max-w-2xl">
      <span class="eyebrow">Team</span>
      <h2 class="text-3xl font-bold sm:text-4xl">{site.team}</h2>
      <p class="mt-3 text-slate-400">{team.intro}</p>
    </div>

    {
      team.groups.map((g) => (
        <div class="reveal mb-8">
          <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-500">{g.role}</h3>
          <ul class="flex flex-wrap gap-2">
            {g.members.map((m) => (
              <li class="rounded-full border border-ink-border bg-ink-card px-3 py-1.5 text-sm text-slate-300">
                {m}
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="reveal mt-8 rounded-2xl border border-ink-border bg-ink-card p-6">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Contact & Collaboration</h3>
      <p class="mt-2 text-slate-400">{team.contactNote}</p>
      <a class="btn-primary mt-4" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>
