---
import { site } from '../data/site';
const BASE = import.meta.env.BASE_URL;
---

<header class="relative overflow-hidden">
  <!-- background glow -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-[-6%] h-[300px] w-[680px] -translate-x-1/2 rounded-full bg-brand/10 blur-[140px]"></div>
    <div class="absolute right-[10%] top-[28%] h-[180px] w-[180px] rounded-full bg-accent/10 blur-[120px]"></div>
  </div>

  <div class="container-wide section pt-20 sm:pt-28">
    <div class="text-center">
      <span class="eyebrow reveal">{site.eyebrow}</span>
      <h1 class="reveal mx-auto max-w-6xl font-extrabold leading-tight tracking-tight">
        <span class="gradient-text text-4xl sm:text-6xl">{site.name}</span><span class="text-faint-2 text-3xl sm:text-5xl"> · <span class="text-faint">T</span>owards <span class="text-faint">A</span>utonomous <span class="text-faint">O</span>peration</span>
      </h1>
      <p class="reveal mx-auto mt-4 max-w-2xl text-lg text-muted">{site.tagline}</p>
    </div>
    <p class="reveal mt-3 mx-auto max-w-4xl text-base text-muted">{site.heroDesc}</p>

    <figure class="reveal mt-6 mx-auto max-w-4xl">
      <blockquote class="border-l-2 border-brand/20 pl-6">
        <p class="text-sm italic leading-relaxed text-faint">
          <span class="font-semibold not-italic text-fg">TAO</span> originates from the central notion of
          Taoism, representing the cosmic source, natural operating rules and ultimate truth, with an
          emphasis on harmony and wu wei (non-action). In <em class="not-italic text-fg">Tao Te Ching</em>, the
          Tao is described as an ineffable primordial principle. Its transliteration “Tao” is adopted in
          Western languages to preserve its distinctive cultural meaning.
        </p>
      </blockquote>
    </figure>

    <div class="reveal mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn-primary" href={site.github} target="_blank" rel="noopener">GitHub</a>
      <a class="btn-ghost" href="#main-work">Explore Work</a>
      <a class="btn-ghost" href="#team">Meet the Team</a>
    </div>

    <p class="reveal mt-10 text-center text-sm text-faint">{site.org} · {site.team}</p>
  </div>
</header>
