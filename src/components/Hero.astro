---
import { site } from '../data/site';
const BASE = import.meta.env.BASE_URL;
---

<header class="relative overflow-hidden">
  <!-- background glow -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-[-6%] h-[300px] w-[680px] -translate-x-1/2 rounded-full bg-brand/10 blur-[140px]"></div>
    <div class="absolute right-[10%] top-[28%] h-[180px] w-[180px] rounded-full bg-accent/10 blur-[120px]"></div>
  </div>

  <div class="container-wide section pt-20 sm:pt-28">
    <span class="eyebrow reveal">{site.eyebrow}</span>
    <h1 class="reveal max-w-6xl font-extrabold leading-tight tracking-tight">
      <span class="gradient-text text-4xl sm:text-6xl">{site.name}</span><span class="text-faint-2 text-3xl sm:text-5xl"> · <span class="text-faint">T</span>owards <span class="text-faint">A</span>utonomous <span class="text-faint">O</span>peration</span>
    </h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-muted">{site.tagline}</p>
    <p class="reveal mt-3 max-w-3xl text-base text-muted">{site.heroDesc}</p>

    <div class="reveal mt-8 flex flex-wrap gap-3">
      <a class="btn-primary" href={site.github} target="_blank" rel="noopener">GitHub</a>
      <a class="btn-ghost" href="#main-work">Explore Work</a>
      <a class="btn-ghost" href="#team">Meet the Team</a>
    </div>

    <p class="reveal mt-10 text-sm text-faint">{site.org} · {site.team}</p>
  </div>
</header>
