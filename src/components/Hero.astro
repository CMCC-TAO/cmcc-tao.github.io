---
import { site } from '../data/site';
const BASE = import.meta.env.BASE_URL;
---

<header class="relative overflow-hidden">
  <!-- background glow -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-[-12%] h-[420px] w-[820px] -translate-x-1/2 rounded-full bg-brand/20 blur-[120px]"></div>
    <div class="absolute right-[8%] top-[18%] h-[260px] w-[260px] rounded-full bg-accent/20 blur-[100px]"></div>
  </div>

  <div class="container-wide section pt-20 sm:pt-28">
    <span class="eyebrow reveal">{site.eyebrow}</span>
    <h1 class="reveal max-w-4xl text-4xl font-extrabold leading-tight tracking-tight sm:text-6xl">
      {site.name}<span class="gradient-text">{site.titleHighlight}</span>
    </h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-slate-300">{site.tagline}</p>
    <p class="reveal mt-3 max-w-3xl text-base text-slate-400">{site.heroDesc}</p>

    <div class="reveal mt-8 flex flex-wrap gap-3">
      <a class="btn-primary" href={site.github} target="_blank" rel="noopener">GitHub</a>
      <a class="btn-ghost" href="#main-work">Explore Work</a>
      <a class="btn-ghost" href="#team">Meet the Team</a>
    </div>

    <p class="reveal mt-10 text-sm text-slate-500">{site.org} · {site.team}</p>
  </div>
</header>
