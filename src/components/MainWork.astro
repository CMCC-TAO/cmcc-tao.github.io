---
import { boards, paper, site } from '../data/site';
---

<section id="main-work" class="section">
  <div class="container-wide">
    <div class="reveal mb-12 max-w-2xl mx-auto text-center">
      <span class="eyebrow">Main Work</span>
      <h2 class="text-3xl font-bold sm:text-4xl">Infrastructure · Model · Benchmark</h2>
      <p class="mt-3 text-muted">
        Three pillars of the TAO ecosystem — from deployment infrastructure to embodied models and evaluation.
      </p>
    </div>

    {
      boards.map((board) => (
        <div class="mb-16 mx-auto max-w-4xl" id={board.id}>
          <div class="reveal mb-4 flex items-end justify-between gap-4 border-b border-ink-border pb-4">
            <div>
              <span class="eyebrow mb-2">{board.eyebrow}</span>
              <h3 class="text-2xl font-bold sm:text-3xl">{board.title}</h3>
            </div>
          </div>
          <p class="reveal mb-6 max-w-3xl text-muted">{board.desc}</p>

          <div class="grid gap-6 grid-cols-1 sm:grid-cols-2">
            {board.items.map((p) => (
              <article class="card lift reveal flex flex-col">
                <div class="mb-4 flex items-center justify-between">
                  <span class="eyebrow mb-0">{p.category}</span>
                  <span class="text-2xl" aria-hidden="true">{p.icon}</span>
                </div>

                <h4 class="text-xl font-bold">{p.name}</h4>
                <p class="mt-1 text-sm font-semibold text-brand-light">{p.tagline}</p>
                <p class="mt-3 text-sm text-muted">{p.desc}</p>

                {p.highlights && (
                  <div class="mt-4 grid grid-cols-2 gap-3 border-t border-ink-border pt-4">
                    {p.highlights.map((h) => (
                      <div>
                        <div class="stat text-2xl">{h.value}</div>
                        <div class="text-xs text-faint">{h.label}</div>
                      </div>
                    ))}
                  </div>
                )}

                <div class="mt-4 flex flex-wrap gap-2">
                  {p.tags.map((tag) => (
                    <span class="rounded-full border border-ink-border px-2.5 py-0.5 text-xs text-muted">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="mt-5 flex flex-wrap gap-3">
                  <a
                    class="btn-ghost px-4 py-2 text-xs"
                    href={p.github ?? site.github}
                    target="_blank"
                    rel="noopener"
                  >
                    GitHub →
                  </a>
                  <a
                    class="btn-ghost px-4 py-2 text-xs"
                    href={p.paper ?? paper}
                    target="_blank"
                    rel="noopener"
                  >
                    Paper →
                  </a>
                  <a
                    class="btn-ghost px-4 py-2 text-xs"
                    href={p.homepage ?? site.site}
                    target="_blank"
                    rel="noopener"
                  >
                    Homepage →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
